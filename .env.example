# versionwatch 环境变量示例（复制为 .env 后可配合 docker compose --env-file .env 使用）
VW_ROOT_DIR=/srv/ftp
VW_FTP_LOG=/var/log/vsftpd/vsftpd.log
VW_DATABASE_URL=postgresql://versionwatch:versionwatch@postgres:5432/versionwatch
VW_LOG_STATE_FILE=/var/lib/versionwatch/ftp_log.state
VW_LOG_LEVEL=INFO

# watchdog 事件去抖（同一路径静默多久视为写入结束）
VW_DEBOUNCE_SECONDS=5
# ftp_log 与 watchdog 事件按路径合并的窗口
VW_MERGE_WINDOW_SECONDS=10

# 定时 hash 校验
VW_HASH_SCAN_ENABLED=true
VW_HASH_SCAN_INTERVAL=900
VW_HASH_ALGO=blake2b
VW_LOG_TIMEZONE=Asia/Shanghai

# 列表类配置需使用 JSON 数组，例如：
# VW_EXCLUDE_PATTERNS=["\\.part$","\\.tmp$","~$"]